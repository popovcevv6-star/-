local tabs = {}
local tabButtons = {}

local function createTab(tabName)
	local btn = Instance.new("TextButton")
	btn.Parent = SidePanel
	btn.BackgroundTransparency = 1
	btn.Size = UDim2.new(1, -10, 0, 28)
	btn.Text = tabName
	btn.TextColor3 = Color3.fromRGB(170, 170, 170)
	btn.TextSize = 16
	btn.TextXAlignment = Enum.TextXAlignment.Left
	btn.Font = Enum.Font.SourceSansBold

	local container = Instance.new("ScrollingFrame")
	container.Parent = ContentArea
	container.BackgroundTransparency = 1
	container.Size = UDim2.new(1, 0, 1, 0)
	container.CanvasSize = UDim2.new(0, 0, 0, 0)
	container.AutomaticCanvasSize = Enum.AutomaticSize.Y
	container.ScrollBarThickness = 4
	container.ScrollBarImageColor3 = Color3.fromRGB(35, 35, 35)
	container.Visible = false

	local listLayout = Instance.new("UIListLayout")
	listLayout.Parent = container
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Padding = UDim.new(0, 8)

	local pad = Instance.new("UIPadding")
	pad.Parent = container
	pad.PaddingTop = UDim.new(0, 12)
	pad.PaddingLeft = UDim.new(0, 12)
	pad.PaddingRight = UDim.new(0, 12)

	tabs[tabName] = container
	tabButtons[tabName] = btn

	btn.MouseButton1Click:Connect(function()
		for _, c in pairs(tabs) do c.Visible = false end
		for _, b in pairs(tabButtons) do b.TextColor3 = Color3.fromRGB(170, 170, 170) end
		container.Visible = true
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	end)

	return container
end

