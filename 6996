local function createToggle(tabContainer, text, callback)
	local toggleBtn = Instance.new("TextButton")
	toggleBtn.Parent = tabContainer
	toggleBtn.BackgroundTransparency = 1
	toggleBtn.Size = UDim2.new(1, -10, 0, 24)
	toggleBtn.Text = text .. " : OFF"
	toggleBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
	toggleBtn.TextSize = 15
	toggleBtn.TextXAlignment = Enum.TextXAlignment.Left
	toggleBtn.Font = Enum.Font.SourceSansPro

	local state = false
	toggleBtn.MouseButton1Click:Connect(function()
		state = not state
		if state then
			toggleBtn.Text = text .. " : ON"
			toggleBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
		else
			toggleBtn.Text = text .. " : OFF"
			toggleBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
		end
		pcall(function() callback(state) end)
	end)
end

local espEnabled = false

createToggle(mainTab, "ESP (через стены)", function(state)
	espEnabled = state
	if not state then
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Character and p.Character:FindFirstChild("MainEspHighlight") then
				p.Character.MainEspHighlight:Destroy()
			end
		end
	end
end)

RunService.RenderStepped:Connect(function()
	if espEnabled then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character then
				local hl = p.Character:FindFirstChild("MainEspHighlight")
				if not hl then
					hl = Instance.new("Highlight")
					hl.Name = "MainEspHighlight"
					hl.Adornee = p.Character
					hl.FillColor = Color3.fromRGB(255, 50, 50)
					hl.OutlineColor = Color3.fromRGB(255, 255, 255)
					hl.FillTransparency = 0.5
					hl.OutlineTransparency = 0
					hl.AlwaysOnTop = true
					hl.Parent = p.Character
				end
			end
		end
	end
end)
