local spinbotEnabled = false
local flingEnabled = false
local invisEnabled = false
local invisFakeRoot = nil
local spinSpeed = 150

local wandTool = nil
local wandTarget = nil
local wandConnection = nil

local function removeWand()
	if wandConnection then
		wandConnection:Disconnect()
		wandConnection = nil
	end
	wandTarget = nil
	if wandTool then
		wandTool:Destroy()
		wandTool = nil
	end
end

createToggle(trollingTab, "Spinbot", function(state)
	spinbotEnabled = state
end)

createToggle(trollingTab, "Fling", function(state)
	flingEnabled = state
	if state then
		task.spawn(function()
			while flingEnabled do
				RunService.Heartbeat:Wait()
				pcall(function()
					local c = LocalPlayer.Character
					local hrp = c and c:FindFirstChild("HumanoidRootPart")
					if hrp then
						local vel = hrp.Velocity
						hrp.Velocity = vel * 10000 + Vector3.new(0, 10000, 0)
						RunService.RenderStepped:Wait()
						hrp.Velocity = vel
					end
				end)
			end
		end)
	end
end)

createToggle(trollingTab, "invisible", function(state)
	invisEnabled = state
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	
	if not char or not hrp or not hum then return end

	if state then
		pcall(function()
			local clone = hrp:Clone()
			clone.Parent = char
			hrp.Transparency = 1
			
			invisFakeRoot = hrp
			char.PrimaryPart = clone

			task.spawn(function()
				while invisEnabled and char and char.Parent do
					RunService.RenderStepped:Wait()
					if invisFakeRoot then
						invisFakeRoot.CFrame = CFrame.new(0, -99999, 0)
					end
				end
			end)
		end)
	else
		pcall(function()
			if invisFakeRoot and char then
				invisFakeRoot.CFrame = char.PrimaryPart.CFrame
				char.PrimaryPart = invisFakeRoot
			end
		end)
	end
end)

createToggle(trollingTab, "Attach Wand", function(state)
	if state then
		removeWand()
		
		local tool = Instance.new("Tool")
		tool.Name = "Magic Wand"
		tool.RequiresHandle = true
		
		local handle = Instance.new("Part")
		handle.Name = "Handle"
		handle.Size = Vector3.new(0.3, 3, 0.3)
		handle.Color = Color3.fromRGB(0, 200, 255)
		handle.Material = Enum.Material.Neon
		handle.Parent = tool
		
		tool.Activated:Connect(function()
			local mouse = LocalPlayer:GetMouse()
			local target = mouse.Target
			
			if target then
				local model = target:FindFirstAncestorOfClass("Model")
				if model then
					local plr = Players:GetPlayerFromCharacter(model)
					if plr and plr ~= LocalPlayer then
						wandTarget = model
						return
					end
				end
			end
			wandTarget = nil
		end)
		
		local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
		if backpack then
			tool.Parent = backpack
		end
		wandTool = tool
		
		wandConnection = RunService.RenderStepped:Connect(function()
			if wandTarget and wandTarget:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
				local myHRP = LocalPlayer.Character.HumanoidRootPart
				local targetHRP = wandTarget.HumanoidRootPart
				myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 2) * CFrame.Angles(0, math.pi, 0)
			end
		end)
	else
		removeWand()
	end
end)

