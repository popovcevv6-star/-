local function createToggle(tabContainer, text, callback)
	local toggleBtn = Instance.new("TextButton")
	toggleBtn.Parent = tabContainer
	toggleBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
	toggleBtn.Size = UDim2.new(1, 0, 0, 40)
	toggleBtn.Text = ""
	addCorner(toggleBtn, 8)

	local stroke = Instance.new("UIStroke")
	stroke.Parent = toggleBtn
	stroke.Color = Color3.fromRGB(50, 50, 65)
	stroke.Thickness = 1

	local titleLabel = Instance.new("TextLabel")
	titleLabel.Parent = toggleBtn
	titleLabel.BackgroundTransparency = 1
	titleLabel.Position = UDim2.new(0, 12, 0, 0)
	titleLabel.Size = UDim2.new(0.6, 0, 1, 0)
	titleLabel.Text = text
	titleLabel.TextColor3 = Color3.fromRGB(220, 220, 240)
	titleLabel.TextSize = 14
	titleLabel.Font = Enum.Font.SourceSansBold
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left

	local statusLabel = Instance.new("TextLabel")
	statusLabel.Parent = toggleBtn
	statusLabel.BackgroundTransparency = 1
	statusLabel.Position = UDim2.new(0.6, 0, 0, 0)
	statusLabel.Size = UDim2.new(0.4, -12, 1, 0)
	statusLabel.Text = "OFF"
	statusLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
	statusLabel.TextSize = 14
	statusLabel.Font = Enum.Font.SourceSansBold
	statusLabel.TextXAlignment = Enum.TextXAlignment.Right

	local state = false
	toggleBtn.MouseButton1Click:Connect(function()
		state = not state
		if state then
			statusLabel.Text = "ON"
			statusLabel.TextColor3 = Color3.fromRGB(90, 255, 90)
			toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 50, 45)
			stroke.Color = Color3.fromRGB(60, 120, 80)
		else
			statusLabel.Text = "OFF"
			statusLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
			toggleBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
			stroke.Color = Color3.fromRGB(50, 50, 65)
		end
		pcall(function() callback(state) end)
	end)
end

local espEnabled = false

createToggle(mainTab, "ESP (Через стены)", function(state)
	espEnabled = state
	if not state then
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Character and p.Character:FindFirstChild("CleanEspHighlight") then
				p.Character.CleanEspHighlight:Destroy()
			end
		end
	end
end)

RunService.RenderStepped:Connect(function()
	if espEnabled then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character then
				local hl = p.Character:FindFirstChild("CleanEspHighlight")
				if not hl then
					hl = Instance.new("Highlight")
					hl.Name = "CleanEspHighlight"
					hl.Adornee = p.Character
					hl.FillColor = Color3.fromRGB(255, 60, 60)
					hl.OutlineColor = Color3.fromRGB(255, 255, 255)
					hl.FillTransparency = 0.4
					hl.OutlineTransparency = 0
					hl.AlwaysOnTop = true
					hl.Parent = p.Character
				end
			end
		end
	end
end)
