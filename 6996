local function getMm2Target(roleType)
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			local char = p.Character
			local found = false
			
			for _, item in ipairs(char:GetChildren()) do
				if item:IsA("Tool") then
					if roleType == "Murderer" and item.Name == "Knife" then found = true end
					if roleType == "Sheriff" and (item.Name == "Gun" or item.Name == "Revolver") then found = true end
				end
			end
			
			local bp = p:FindFirstChildOfClass("Backpack")
			if bp then
				for _, item in ipairs(bp:GetChildren()) do
					if item:IsA("Tool") then
						if roleType == "Murderer" and item.Name == "Knife" then found = true end
						if roleType == "Sheriff" and (item.Name == "Gun" or item.Name == "Revolver") then found = true end
					end
				end
			end
			
			if found then
				return char
			end
		end
	end
	return nil
end

local isFlingingRole = false

local function performRoleFling(roleType)
	if isFlingingRole then return end
	local targetChar = getMm2Target(roleType)
	if not targetChar or not targetChar:FindFirstChild("HumanoidRootPart") then return end
	
	local myChar = LocalPlayer.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
	
	local myHrp = myChar.HumanoidRootPart
	local startPosition = myHrp.CFrame
	isFlingingRole = true
	
	task.spawn(function()
		local startTime = tick()
		while tick() - startTime < 0.4 and myHrp and targetChar and targetChar.Parent and myHrp.Parent do
			RunService.Heartbeat:Wait()
			local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
			if targetHrp then
				myHrp.CFrame = targetHrp.CFrame
				myHrp.Velocity = Vector3.new(30000, 30000, 30000)
				myHrp.RotVelocity = Vector3.new(50000, 50000, 50000)
			else
				break
			end
		end
		
		if myHrp and myHrp.Parent then
			myHrp.CFrame = startPosition
			myHrp.Velocity = Vector3.new(0, 0, 0)
			myHrp.RotVelocity = Vector3.new(0, 0, 0)
		end
		
		isFlingingRole = false
	end)
end

createButton(mm2Tab, "Fling Murderer", function()
	performRoleFling("Murderer")
end)

createButton(mm2Tab, "Fling Sheriff", function()
	performRoleFling("Sheriff")
end)

