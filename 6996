local function createToggle(tab, titleText, callback)
	local toggle = Instance.new("TextButton")
	toggle.Parent = tab
	toggle.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
	toggle.Size = UDim2.new(1, 0, 0, 42)
	toggle.Text = ""
	round(toggle, 8)
	local s = stroke(toggle, Color3.fromRGB(38, 38, 52), 1)

	local title = Instance.new("TextLabel")
	title.Parent = toggle
	title.BackgroundTransparency = 1
	title.Position = UDim2.new(0, 12, 0, 0)
	title.Size = UDim2.new(0, 140, 1, 0)
	title.Text = titleText
	title.TextColor3 = Color3.fromRGB(210, 210, 230)
	title.TextSize = 13
	title.Font = Enum.Font.GothamSemibold
	title.TextXAlignment = Enum.TextXAlignment.Left

	local indicator = Instance.new("Frame")
	indicator.Parent = toggle
	indicator.AnchorPoint = Vector2.new(1, 0.5)
	indicator.Position = UDim2.new(1, -12, 0.5, 0)
	indicator.Size = UDim2.new(0, 36, 0, 20)
	indicator.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
	round(indicator, 10)

	local circle = Instance.new("Frame")
	circle.Parent = indicator
	circle.AnchorPoint = Vector2.new(0, 0.5)
	circle.Position = UDim2.new(0, 3, 0.5, 0)
	circle.Size = UDim2.new(0, 14, 0, 14)
	circle.BackgroundColor3 = Color3.fromRGB(150, 150, 170)
	round(circle, 7)

	local state = false
	toggle.MouseButton1Click:Connect(function()
		state = not state
		if state then
			indicator.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
			circle.Position = UDim2.new(1, -17, 0.5, 0)
			circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			s.Color = Color3.fromRGB(0, 150, 80)
		else
			indicator.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
			circle.Position = UDim2.new(0, 3, 0.5, 0)
			circle.BackgroundColor3 = Color3.fromRGB(150, 150, 170)
			s.Color = Color3.fromRGB(38, 38, 52)
		end
		pcall(function() callback(state) end)
	end)
end

local espEnabled = false
local invisFullEnabled = false

local function removeEsp(player)
	if player.Character then
		local gui = player.Character:FindFirstChild("WorkingEspGui")
		if gui then gui:Destroy() end
	end
end

createToggle(visualTab, "ESP", function(state)
	espEnabled = state
	if not state then
		for _, p in ipairs(Players:GetPlayers()) do
			removeEsp(p)
		end
	end
end)

createToggle(visualTab, "Invisible Full", function(state)
	invisFullEnabled = state
	local char = LocalPlayer.Character
	if not char then return end

	if not state then
		for _, v in ipairs(char:GetDescendants()) do
			if v:IsA("BasePart") or v:IsA("Decal") then
				if v.Name ~= "HumanoidRootPart" then
					v.Transparency = 0
				end
				if v:IsA("BasePart") then
					v.LocalTransparencyModifier = 0
				end
			elseif v:IsA("ParticleEmitter") or v:IsA("Beam") or v:IsA("Trail") then
				v.Enabled = true
			end
		end
	end
end)

local spinbotEnabled = false
local flingEnabled = false
local spinSpeed = 150

createToggle(trollingTab, "Spinbot", function(state)
	spinbotEnabled = state
end)

createToggle(trollingTab, "Fling", function(state)
	flingEnabled = state
	if state then
		task.spawn(function()
			while flingEnabled do
				RunService.Heartbeat:Wait()
				pcall(function()
					local c = LocalPlayer.Character
					local hrp = c and c:FindFirstChild("HumanoidRootPart")
					if hrp then
						local vel = hrp.Velocity
						hrp.Velocity = vel * 10000 + Vector3.new(0, 10000, 0)
						RunService.RenderStepped:Wait()
						hrp.Velocity = vel
					end
				end)
			end
		end)
	end
end)

RunService.RenderStepped:Connect(function()
	if espEnabled then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local hrp = p.Character.HumanoidRootPart
				local gui = p.Character:FindFirstChild("WorkingEspGui")
				
				if not gui then
					gui = Instance.new("BillboardGui")
					gui.Name = "WorkingEspGui"
					gui.Adornee = hrp
					gui.AlwaysOnTop = true
					gui.Size = UDim2.new(0, 24, 0, 36)
					gui.StudsOffset = Vector3.new(0, 0, 0)

					local frame = Instance.new("Frame")
					frame.Parent = gui
					frame.Size = UDim2.new(1, 0, 1, 0)
					frame.BackgroundTransparency = 0.6
					frame.BackgroundColor3 = Color3.fromRGB(255, 0, 80)
					round(frame, 3)
					stroke(frame, Color3.fromRGB(255, 255, 255), 1)

					local label = Instance.new("TextLabel")
					label.Parent = frame
					label.Size = UDim2.new(1, 0, 0, 12)
					label.Position = UDim2.new(0, 0, -0.35, 0)
					label.BackgroundTransparency = 1
					label.Text = p.DisplayName
					label.TextColor3 = Color3.fromRGB(255, 255, 255)
					label.TextSize = 9
					label.Font = Enum.Font.GothamBold

					gui.Parent = p.Character
				end
			end
		end
	end

	if invisFullEnabled and LocalPlayer.Character then
		local char = LocalPlayer.Character
		for _, v in ipairs(char:GetDescendants()) do
			if v:IsA("BasePart") then
				v.Transparency = 1
				v.LocalTransparencyModifier = 1
			elseif v:IsA("Decal") then
				v.Transparency = 1
			elseif v:IsA("ParticleEmitter") or v:IsA("Beam") or v:IsA("Trail") then
				v.Enabled = false
			end
		end
	end

	if spinbotEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
		local hrp = LocalPlayer.Character.HumanoidRootPart
		hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(spinSpeed), 0)
	end
end)

Players.PlayerRemoving:Connect(removeEsp)
